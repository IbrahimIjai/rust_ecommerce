# ─── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Docker: spin up with `docker compose up -d`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rust_ecommerce

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: `openssl rand -hex 32`
# NEVER use this placeholder in production
JWT_SIGNING_KEY=change-me-to-a-random-32-plus-char-secret

# ─── Paystack ─────────────────────────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developer
# Set to "sk_test_placeholder" OR set PAYSTACK_MOCK=true to use mock mode
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_MOCK=true

# Paystack will POST events to this endpoint (use ngrok in dev)
# PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=rust_ecommerce=debug,tower_http=debug
